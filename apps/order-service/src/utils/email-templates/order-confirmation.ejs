<!DOCTYPE html>
<html>
  <head>
    <title>Eshop Order Confirmation</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <style type="text/css">
      body {
        margin: 0;
        padding: 0;
        min-width: 100%;
        font-family: Arial, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        background-color: #fafafa;
        color: #222222;
      }

      a {
        color: #ffffff;
        text-decoration: none;
      }

      h1 {
        font-size: 24px;
        font-weight: 700;
        line-height: 1.25;
        margin: 0;
        text-align: center;
      }

      h2 {
        color: #0070f3;
        margin-bottom: 20px;
      }

      p {
        margin-top: 0;
        margin-bottom: 20px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
      }

      table th,
      table td {
        padding: 12px;
        border-bottom: 1px solid #e5e5e5;
        text-align: left;
      }

      table th {
        background-color: #f7f7f7;
        font-weight: bold;
      }

      .email-wrapper {
        max-width: 600px;
        margin: 0 auto;
      }

      .email-header {
        background-color: #0070f3;
        color: #ffffff;
        padding: 24px;
      }

      .email-body {
        background-color: #ffffff;
        padding: 24px;
      }

      .email-footer {
        background-color: #f6f6f6;
        padding: 24px;
        text-align: center;
        color: #666666;
        font-size: 14px;
      }

      .total-box {
        background-color: #f8f9fa;
        padding: 16px;
        border-radius: 6px;
        margin: 20px 0;
        font-size: 18px;
        font-weight: bold;
      }

      .button {
        display: inline-block;
        background-color: #0070f3;
        color: #ffffff;
        font-size: 16px;
        font-weight: bold;
        text-decoration: none;
        padding: 12px 24px;
        border-radius: 4px;
        margin-top: 20px;
      }

      .center {
        text-align: center;
      }
    </style>
  </head>

  <body>
    <div class="email-wrapper">
      <div class="email-header">
        <h1>🛒 Eshop Order Confirmation</h1>
      </div>

      <div class="email-body">
        <h2>Order Confirmed ✅</h2>

        <p>Hi <strong><%= name %></strong>,</p>

        <p>
          Thank you for your order! We are excited to let you know that your
          order has been successfully placed and will be processed shortly.
        </p>

        <p><strong>Here are the details of your order:</strong></p>

        <table>
          <thead>
            <tr>
              <th>Product</th>
              <th>Quantity</th>
              <th>Price</th>
            </tr>
          </thead>

          <tbody>
            <% cart.forEach(item => { %>
            <tr>
              <td><%= item.title %></td>
              <td><%= item.quantity %></td>
              <td>$<%= item.sale_price.toFixed(2) %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>

        <div class="total-box">
          Total Amount:
          <span style="color: #0070f3;">
            $<%= totalAmount.toFixed(2) %>
          </span>
        </div>

        <div class="center">
          <a href="<%= trackingUrl %>" class="button">
            Track Your Order
          </a>
        </div>

        <p style="margin-top:30px;">
          We'll notify you again as soon as your order has been shipped.
        </p>

        <p>
          Thank you for shopping with <strong>Eshop</strong>. We appreciate your
          trust and look forward to serving you again!
        </p>
      </div>

      <div class="email-footer">
        <p>&copy; 2026 Eshop. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>